syntax = "v1"

info (
	title:   "mcp服务"
	desc:    "mcp服务接口"
	author:  "wcs"
	email:   ""
	version: "v1.0.0"
)

import "./base.api"

@server (
	group:  mcp
	prefix: /manager/api/admin/mcp
	jwt:    Auth
)
service admin-api {
	// 获取MCP服务列表
	@handler ServiceList
	get /service/list (ServiceListReq) returns (BaseResp)

	// 获取MCP服务详情
	@handler ServiceDetail
	get /service/detail/:id (DetailReq) returns (BaseResp)

	// 生成任务链与节点
	@handler ServiceTaskCreate
	post /service/task/create (ServiceTaskCreateReq) returns (BaseResp)

	// 获取MCP服务配置
	//    @handler ServiceConfig
	//    get /service/config (ServiceDetailReq) returns (BaseResp)
	// 获取MCP服务安装列表
	@handler ServiceInstallList
	get /service/install/list (ServiceInstallListReq) returns (BaseResp)

	// 生成shell脚本
	@handler ServiceShellCreate
	post /service/shell/create (ServiceShellCreateReq) returns (BaseResp)

	// 生成预装脚本
	@handler ServicePreInstallCreate
	post /service/pre_install/create (ServicePreInstallCreateReq) returns (BaseResp)

	// 更新是否启动创建
	@handler ServiceUpdateIsCreate
	post /service/update/is_create (ServiceUpdateIsCreateReq) returns (BaseResp)

	// 删除数据（包含链，节点，配置，安装命令）
	@handler ServiceDelete
	delete /service/delete (ServiceDeleteReq) returns (BaseResp)

	// 批量修改启动分组
	@handler ServiceUpdateCreatedGroup
	post /service/update/created-group (ServiceUpdateCreatedGroupReq) returns (BaseResp)

	// 批量关闭服务
	@handler ServiceBatchClose
	post /service/batch-close (ServiceBatchCloseReq) returns (BaseResp)

	// 删除服务配置
	@handler ServiceConfigDelete
	delete /service/config/delete (ServiceConfigDeleteReq) returns (BaseResp)

	// 配置账号列表
	@handler ServiceConfigAccountList
	get /service/config/account/list (ServiceConfigAccountListReq) returns (BaseResp)

	// 批量修改账号状态
	@handler ServiceConfigAccountUpdateStatus
	post /service/config/account/update-status (ServiceConfigAccountUpdateStatusReq) returns (BaseResp)

	// 批量删除账号信息
	@handler ServiceConfigAccountDelete
	delete /service/config/account/delete (ServiceConfigAccountDeleteReq) returns (BaseResp)

	// 创建账号信息
	@handler ServiceConfigAccountCreate
	post /service/config/account/create (ServiceConfigAccountCreateReq) returns (BaseResp)

	// 更新账号信息
	@handler ServiceConfigAccountUpdate
	post /service/config/account/update (ServiceConfigAccountUpdateReq) returns (BaseResp)

	// 更新服务价格
	@handler ServiceUpdatePrice
	post /service/update/price (ServiceUpdatePriceReq) returns (BaseResp)

	// 批量更新服务价格
	@handler ServiceBatchUpdatePrice
	post /service/batch-update-price (ServiceBatchUpdatePriceReq) returns (BaseResp)

	// ==================== MCP服务测试接口 ====================
	// 连接测试 - 获取工具列表
	@handler ServiceTestConnect
	post /service/test/connect (ServiceTestConnectReq) returns (BaseResp)

	// 调用工具
	@handler ServiceTestCall
	post /service/test/call (ServiceTestCallReq) returns (BaseResp)

	// 确认测试结果
	@handler ServiceTestConfirm
	post /service/test/confirm (ServiceTestConfirmReq) returns (BaseResp)
}

@server (
	group:  mcp
	prefix: /manager-inner
)
service admin-api {
	@handler InnerMcpInfo
	get /mcpinfo returns (BaseResp)
}

type (
	ServiceListReq {
		BaseListReq
		Enabled   int64  `form:"enabled,optional"`
		IsInstall int64  `form:"is_install,optional"`
		IsCreated int64  `form:"is_created,optional"`
		ServerId  string `form:"server_id,optional"`
	}
	ServiceTaskCreateReq {
		Ids []int64 `json:"ids"`
	}
	ServiceInstallListReq {
		BaseListReq
		ServerId string `form:"server_id,optional"`
	}
	ServiceShellCreateReq {
		InstallIds []int64 `json:"install_ids"`
	}
	ServicePreInstallCreateReq {
		InstallIds []int64 `json:"install_ids"`
	}
	ServiceUpdateIsCreateReq {
		Id        int64 `json:"id"`
		IsCreated bool  `json:"is_created"`
	}
	ServiceDeleteReq {
		Ids []int64 `json:"ids"`
	}
	ServiceUpdateCreatedGroupReq {
		Ids          []int64 `json:"ids"`
		CreatedGroup int64   `json:"created_group"`
	}
	ServiceBatchCloseReq {
		Ids []int64 `json:"ids"`
	}
	ServiceConfigDeleteReq {
		Ids []int64 `json:"ids"`
	}
	ServiceConfigAccountListReq {
		BaseListReq
		ServerId string `form:"server_id,optional"`
		Status   string `form:"status,optional"`
		ConfigId int64  `form:"config_id,optional"`
	}
	ServiceConfigAccountUpdateStatusReq {
		Ids    []int64 `json:"ids"`
		Status string  `json:"status"`
	}
	ServiceConfigAccountDeleteReq {
		Ids []int64 `json:"ids"`
	}
	ServiceConfigAccountCreateReq {
		Name     string `json:"name"`
		AuthInfo string `json:"auth_info"`
		ConfigId int64  `json:"config_id"`
		Status   string `json:"status"`
	}
	ServiceConfigAccountUpdateReq {
		Id       int64   `json:"id"`
		Name     string  `json:"name"`
		AuthInfo *string `json:"auth_info,omitempty"`
		ConfigId *int64  `json:"config_id,omitempty"`
		Status   string  `json:"status"`
	}
	ServiceUpdatePriceReq {
		ServerId string `json:"server_id"`
		Price    float64  `json:"price,optional"`
	}
	ServiceBatchUpdatePriceReq {
		Ids       []int64 `json:"ids,optional"`
		Price     float64 `json:"price"`
		IsAll     bool    `json:"is_all,optional"`
		Search    string  `json:"search,optional"`
		Enabled   int     `json:"enabled,optional"`
		IsInstall int     `json:"is_install,optional"`
		IsCreated int     `json:"is_created,optional"`
		ServerId  string  `json:"server_id,optional"`
	}

	// ==================== MCP服务测试类型 ====================
	// 连接测试请求
	ServiceTestConnectReq {
		ConfigId int64 `json:"config_id"`           // 服务配置ID (ae_mcp_external_services_config_v2.id)
		Timeout  int   `json:"timeout,optional"`    // 超时秒数，默认30
	}

	// 工具调用请求
	ServiceTestCallReq {
		ConfigId  int64  `json:"config_id"`          // 服务配置ID
		ToolName  string `json:"tool_name"`          // 工具名称
		Arguments string `json:"arguments,optional"` // 工具参数JSON字符串
		Timeout   int    `json:"timeout,optional"`   // 超时秒数，默认30
	}

	// 确认测试结果请求
	ServiceTestConfirmReq {
		ConfigId   int64 `json:"config_id"`   // 服务配置ID
		TestStatus int   `json:"test_status"` // 测试状态: 1=通过, -1=失败
	}
)
