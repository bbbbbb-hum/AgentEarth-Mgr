syntax = "v1"

info (
	title:   "用户资金管理"
	desc:    "资金管理模块"
	author:  "cbl"
	email:   ""
	version: "v1.0.0"
)

type (
    UserFundStatsResp {
        TotalUsers int64 `json:"total_users"`
        DailyActiveUsers int64 `json:"daily_active_users"`
        TotalRecharge24h float64 `json:"total_recharge_24h"`
    }

    UserListReq {
        Page int `form:"page,default=1"`
        PageSize int `form:"pageSize,default=10"`
        Search string `form:"search,optional"`
        Status string `form:"status,optional"` // active: 30天内登录, inactive: 超过30天未登录
    }

    UserListResp {
        List []UserItem `json:"list"`
        Total int64 `json:"total"`
    }

    UserItem {
        Id int64 `json:"id"`
        UserId string `json:"user_id"`
        Username string `json:"username"`
        Phone string `json:"phone"`
        Email string `json:"email"`
        AvatarUrl string `json:"avatar_url"`
        Status string `json:"status"`
        LastLoginAt string `json:"last_login_at"`
        CreateTime string `json:"create_time"`
        Balance float64 `json:"balance"`
        DailyConsumption float64 `json:"daily_consumption"` // 日均消费
    }

    UserDetailReq {
        UserId string `path:"user_id"`
    }

    UserDetailResp {
        User UserItem `json:"user"`
        CurrentBalance float64 `json:"current_balance"`
        DailyConsumption float64 `json:"daily_consumption"`
        FundRunway int64 `json:"fund_runway"` // 资金续航天数
    }

    ConsumptionRecordReq {
        UserId string `path:"user_id"`
        Days int `form:"days,default=7"` // 7 或 30
    }

    ConsumptionRecordItem {
        Day string `json:"day"` // 日期 YYYY-MM-DD
        SelfConsume float64 `json:"self_consume"` // 自行消费金额
        SystemDeduct float64 `json:"system_deduct"` // 系统扣减金额（来自充值表负值）
    }

    ConsumptionRecordResp {
        List []ConsumptionRecordItem `json:"list"`
    }

    BalanceHistoryReq {
        UserId string `path:"user_id"`
        Days int `form:"days,default=7"` // 7 或 30
    }

    BalanceHistoryItem {
        Day string `json:"day"` // 日期 YYYY-MM-DD
        Balance float64 `json:"balance"` // 余额
    }

    BalanceHistoryResp {
        List []BalanceHistoryItem `json:"list"`
    }

    FundChangeRecordReq {
        UserId string `path:"user_id"`
        Filter string `form:"filter,optional"` // all, recharge, deduction
        ChargeType int64 `form:"charge_type,optional"` // 101 用户常规充值；201 系统故障补偿；301 活动赠送；141 过期扣减；341 管理员扣减
        Page int64 `form:"page,optional"`
        PageSize int64 `form:"page_size,optional"`
    }

    FundChangeRecordItem {
        TransactionTime string `json:"transaction_time"`
        TypeDescription string `json:"type_description"`
        ChangeAmount float64 `json:"change_amount"`
        Status string `json:"status"`
        Remarks string `json:"remarks"`
        ChargeType int64 `json:"charge_type"`
        ChargeTypeDesc string `json:"charge_type_desc"`
        Operator string `json:"operator"`
        BatchId int64 `json:"batch_id,omitempty"`
        InitialAmount float64 `json:"initial_amount,omitempty"`
        RemainingAmount float64 `json:"remaining_amount,omitempty"`
        RemainingAtExpire float64 `json:"remaining_at_expire"`
        ExpireTime string `json:"expire_time,omitempty"`
        BatchStatus string `json:"batch_status,omitempty"`
        OverdraftAmount float64 `json:"overdraft_amount,omitempty"`
    }

    FundChangeRecordResp {
        List []FundChangeRecordItem `json:"list"`
        Total int64 `json:"total"`
    }

    ManualRechargeReq {
        UserId string `json:"user_id"`
        Amount float64 `json:"amount"`
        ChargeType int64 `json:"charge_type"` // 充值类型：101 用户常规充值；201 系统故障补偿；301 活动赠送
        Remarks string `json:"remarks,optional"`
        ExpireTime string `json:"expire_time,optional"` // 可选，格式 YYYY-MM-DD，不传或空为永久有效
    }

    ManualRechargeResp {
        Success bool `json:"success"`
        Message string `json:"message"`
        NewBalance float64 `json:"new_balance"`
    }

    ManualDeductionReq {
        UserId string `json:"user_id"`
        Amount float64 `json:"amount"`
        ChargeType int64 `json:"charge_type"` // 扣减类型：141 过期扣减；341 管理员扣减
        Remarks string `json:"remarks,optional"`
    }

    ManualDeductionResp {
        Success bool `json:"success"`
        Message string `json:"message"`
        NewBalance float64 `json:"new_balance"`
    }
)

@server(
    group: userfund
    prefix: /manager/api/userfund
)
service admin-api {
    @handler GetStats
    get /stats returns (UserFundStatsResp)

    @handler GetUserList
    get /list (UserListReq) returns (UserListResp)

    @handler GetUserDetail
    get /user/:user_id (UserDetailReq) returns (UserDetailResp)

    @handler GetConsumptionRecords
    get /user/:user_id/consumption (ConsumptionRecordReq) returns (ConsumptionRecordResp)

    @handler GetBalanceHistory
    get /user/:user_id/balance (BalanceHistoryReq) returns (BalanceHistoryResp)

    @handler GetFundChangeRecords
    get /user/:user_id/fund-changes (FundChangeRecordReq) returns (FundChangeRecordResp)

    @handler ManualRecharge
    post /user/recharge (ManualRechargeReq) returns (ManualRechargeResp)

    @handler ManualDeduction
    post /user/deduction (ManualDeductionReq) returns (ManualDeductionResp)
}
