syntax = "v1"

info (
	title:   "数据源"
	desc:    "源数据接口"
	author:  "wcs"
	email:   ""
	version: "v1.0.0"
)

import "./base.api"

@server (
	group:  source
	prefix: /manager/api/admin/source
)
service admin-api {
	// 获取数据源列表
	@handler List
	get /list (SourceListReq) returns (BaseResp)

	// 获取数据源详情
	@handler Detail
	get /detail/:id (DetailReq) returns (BaseResp)

	// 更新数据源接口
	@handler Update
	put /update (SourceUpdateReq) returns (BaseResp)

	// 按ID列表生成批量MCP服务与配置
	@handler ServiceBatchCreate
	post /service/batch/create (ServiceBatchCreateReq) returns (BaseResp)

	// 下线 服务
	@handler ServiceOffline
	post /service/offline (ServiceOfflineReq) returns (BaseResp)

	// 调整源数据状态
	@handler ServiceTestStatusUpdate
	post /service/test-status-update (ServiceTestStatusUpdateReq) returns (BaseResp)


	// 源数据账号列表
	@handler AccountList
	get /account/list (AccountListReq) returns (BaseResp)

	// 同步账号数据到Mcp服务配置账号表
	@handler AccountSync
	post /account/sync (AccountSyncReq) returns (BaseResp)

}

type (
	SourceListReq {
		BaseListReq
		TestStatus string `form:"test_status,optional"`
		ServerType string `form:"server_type,optional"`
	}
	ServiceBatchCreateReq {
		Ids []int64 `json:"ids"` // 数据源ID列表
	}
	ServiceOfflineReq {
		Ids []int64 `json:"ids"` // 数据源ID列表
	}
	AccountListReq {
		BaseListReq
		SourceId int64 `form:"source_id,optional"`
	}
	AccountSyncReq {
		Ids []int64 `json:"ids"` // 账号ID列表
	}
	ServiceTestStatusUpdateReq {
		Ids        []int64 `json:"ids"` // 数据源ID
		TestStatus int64   `json:"test_status"` // 测试状态
	}
	SourceUpdateReq {
		Id              int64  `json:"id"` // 自增ID
		ServerName      string `json:"server_name"` // 服务名称
		ServerType      string `json:"server_type"` // 服务类型：stdio,sse,httpStream
		LaunchInfo      string `json:"launch_info"` // 启动信息，例如：{      "command": "npx",      "args": ["-y", "time-mcp"]}
		ConnectInfo     string `json:"connect_info"` // 连接信息，如：{  "url": "http://api.remote.com/mcp/sse"}
		Description     string `json:"description"` // 服务描述
		CodeSourceUrl   string `json:"code_source_url"` // 来源地址：可以是github项目地址，也可以是原MCP服务的文档地址
		TestStatus      int64  `json:"test_status"` // 测试状态：0 未测试 1 通过 -1 未通过
		DockerCmd       string `json:"docker_cmd"`
		ProjectName     string `json:"project_name"`
		Valuable        string `json:"valuable"` // 有价值的服务
		Calls           int64  `json:"calls"` // 流量
		Category        string `json:"category"` // 品类
		Image           string `json:"image"` // 图片
		CloneRepository string `json:"clone_repository"` // 克隆仓库地址
		NeedKey         int64  `json:"need_key"` // 1 需要key 0不需要key
		Install         string `json:"install"` // 安装命令
	}
)
