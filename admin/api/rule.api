syntax = "v1"

info (
	title:   "自动化规则配置"
	desc:    "负责规则的增删改查与手动执行"
	author:  "cbl"
	email:   ""
	version: "v1.0.0"
)

type (
    // 规则的展示实体 (对应数据库 ae_marketing_rule)
    RuleItem {
        Id             int64  `json:"id"`
        Name           string `json:"name"`
        Description    string `json:"description"`
        IsActive       bool   `json:"is_active"` // 对应 sql 里的 bool 类型
        CronExpression string `json:"cron_expression"`
        FilterConfig   string `json:"filter_config"` // JSONB 传给前端转成 String
        ActionConfig   string `json:"action_config"` // JSONB 传给前端转成 String
        CreateTime     string `json:"create_time"`
    }

    // 保存规则请求 (包含新建和编辑；表单字段由后端转为 filter_config/action_config)
    SaveRuleReq {
        Id             int64  `json:"id,optional"`
        Name           string `json:"name"`
        Description    string `json:"description,optional"`
        IsActive       bool   `json:"is_active"`
        CronExpression string `json:"cron_expression,optional"`
        FilterConfig   string `json:"filter_config,optional"`
        ActionConfig   string `json:"action_config,optional"`
        Frequency      string   `json:"frequency,optional"`
        DayOfMonth     int64    `json:"day_of_month,optional"`
        DayOfWeek      int64    `json:"day_of_week,optional"`
        ExecTime       string   `json:"exec_time,optional"`
        TargetStatuses []string `json:"target_statuses,optional"`
        MinRegDays     int64    `json:"min_reg_days,optional"`
        MaxRegDays     int64    `json:"max_reg_days,optional"`
        LastLoginWithinDays int64   `json:"last_login_within_days,optional"`
        MinLastMonthConsume float64 `json:"min_last_month_consume,optional"`
        MaxLastMonthConsume float64 `json:"max_last_month_consume,optional"`
        MinBalance     float64 `json:"min_balance,optional"`
        MaxBalance     float64 `json:"max_balance,optional"`
        ActionType     string  `json:"action_type,optional"`
        ActionAmount   float64 `json:"action_amount,optional"`
        ExpireStrategy string  `json:"expire_strategy,optional"`
    }

    // 规则列表响应数据
    RuleListResp {
        Total int64      `json:"total"`
        List  []RuleItem `json:"list"`
    }

    // 切换状态请求 (快捷启停)
    ToggleRuleReq {
        Id       int64 `json:"id"`
        IsActive bool  `json:"is_active"`
    }

    // 手动执行请求
    ManualRunReq {
        RuleId int64 `json:"rule_id"`
    }

    // 手动执行响应
    ManualRunResp {
        Success        bool   `json:"success"`          // 是否执行成功
        ExecCount      int    `json:"exec_count"`       // 兼容字段：等同于 success_count
        EligibleCount  int64  `json:"eligible_count"`   // 当次符合筛选条件的用户数
        SuccessCount   int64  `json:"success_count"`    // 实际成功写入充值记录的用户数
        FailedCount    int64  `json:"failed_count"`     // 失败数 = EligibleCount - SuccessCount（如出现异常）
        Message        string `json:"message"`          // 提示文案
    }
)

@server (
    jwt: Auth
    group: rules
    prefix: /manager/api/rules
)
service admin-api {
    @handler GetRuleList

    get /list (BaseListReq) returns (RuleListResp)

    @handler SaveRule
    post /save (SaveRuleReq)

    @handler ToggleRule
    post /toggle (ToggleRuleReq)

    @handler ManualRun
    post /manual-run (ManualRunReq) returns (ManualRunResp)
}