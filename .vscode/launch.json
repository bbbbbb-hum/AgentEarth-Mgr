    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Launch Admin API (Default)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/admin",
            "env": {},
            "args": [
                "-f",
                "etc/admin-api.yaml"
            ],
            "showLog": true,
            "cwd": "${workspaceFolder}/admin"
        },
        {
            "name": "Launch Admin API (Test)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/admin",
            "env": {},
            "args": [
                "-f",
                "etc/admin_test-api.yaml"
            ],
            "showLog": true,
            "cwd": "${workspaceFolder}/admin"
        },
        {
            "name": "Launch Admin API (Production)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/admin",
            "env": {},
            "args": [
                "-f",
                "etc/admin_prod-api.yaml"
            ],
            "showLog": true,
            "cwd": "${workspaceFolder}/admin"
        },
        {
            "name": "Attach to Process",
            "type": "go",
            "request": "attach",
            "mode": "local",
            "processId": 0
        }
    ]
}